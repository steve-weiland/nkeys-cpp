prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@PKGCONFIG_LIBDIR@
includedir=@PKGCONFIG_INCLUDEDIR@

Name: nkeys
Description: C++20 port of the NATS NKeys library (Ed25519 auth, XKeys encryption)
URL: https://github.com/steve-weiland/nkeys-cpp
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lnkeys
Cflags: -I${includedir}
